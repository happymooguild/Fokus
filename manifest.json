{
  "manifest_version": 3,
  "name": "Fokus - Take back YouTube",
  "short_name": "Fokus",
  "version": "1.0.0",
  "description": "Toggle away YouTube's distractions - Shorts, the homepage feed, recommendations, comments and more. Every switch is reversible, any time.",
  "homepage_url": "https://github.com/happymooguild/fokus",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Fokus",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/features.js", "src/content/content.js"],
      "css": ["src/content/fokus.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/player-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
